# LLM 提供商（至少配置一个）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# 数据库
DATABASE_URL=sqlite:///./data/app.db

# 认证
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10080

# 应用
APP_HOST=127.0.0.1
APP_PORT=8000
WORKSPACE_DIR=./workspace
LOG_DIR=./logs
MAX_CONCURRENT_WORKFLOWS=3
CODE_EXEC_TIMEOUT=30
SANDBOX_ENABLED=false
